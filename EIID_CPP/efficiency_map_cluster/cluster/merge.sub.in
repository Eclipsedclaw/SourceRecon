universe = vanilla
executable = @@PYTHON@@
arguments = @@PROJECT@@/cluster/workflow.py merge --manifest @@MANIFEST@@
initialdir = @@PROJECT@@
getenv = False
should_transfer_files = NO
request_cpus = 1
request_memory = @@MERGE_MEMORY@@MB
request_disk = @@DISK@@MB
requirements = @@REQUIREMENTS@@
@@OS_ATTRIBUTE@@
log = @@RUN@@/logs/scheduler.log
output = @@RUN@@/logs/merge_$(Cluster)_$(Process).out
error = @@RUN@@/logs/merge_$(Cluster)_$(Process).err
queue 1
