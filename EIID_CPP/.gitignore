**/ResponseKernel/tests/test_kernel_interpolation
**/ResponseKernel/tests/test_kernel_normalization
**/ResponseKernel/tests/test_gaussian_lorentzian_mixture
**/PixelIntegration/tests/test_pixel_sampling

# 数据、模拟运行、图片和打包产物。不要忽略整个 config/ 或所有 JSON。
*.root
*.root.tmp.*
runs/
run/
output/
outputs/
figures/
logs/
dist/
*.log
*.zip
*.tar
*.tar.gz
*.tgz

# 本机环境与自动探测路径：模板 .example 保留。
**/config/environment.sh
**/config/local.mk
**/config/local.mk.tmp
runtime_paths.sh
.env
.env.local

# 缓存和编辑器临时文件；源码脚本、文档和 third_party/ 不整体忽略。
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
