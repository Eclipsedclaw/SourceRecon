# This file documents the machine-local variables generated by configure.sh.
# Do not edit every module Makefile. Run `make configure` from the V7 root.
# PROJECT_CXX_STANDARD is the one authoritative language-standard setting.
# ROOT/Geant4 -std flags are filtered out by module Makefiles.

EIID_LOCAL_CONFIGURED := 1
PROJECT_CXX_STANDARD := c++20
CXX := /absolute/path/to/g++
EIID_DEPS_PREFIX := /absolute/path/to/dependency/prefix
ROOT_CONFIG := /absolute/path/to/root-config
GEANT4_CONFIG := /absolute/path/to/geant4-config
EIID_HAVE_GEANT4 := 1
HEALPIX_CFLAGS := -I/absolute/path/to/include/healpix_cxx
HEALPIX_LIBS := -L/absolute/path/to/lib -lhealpix_cxx -lcxxsupport
JSON_CFLAGS := -I/absolute/path/to/include
EIID_RPATH_FLAGS := -Wl,--disable-new-dtags -Wl,-rpath,/absolute/path/to/lib
