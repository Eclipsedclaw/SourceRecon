{
  "schema_version": "0.1.0",
  "profile_purpose": "stage2_legacy_tree1_example_not_formal_response",
  "paths": {
    "project_root": "../..",
    "input_root": "../../data/input",
    "response_root": "../../response_campaign/response_library",
    "output_root": "../../runs",
    "log_root": "../../logs"
  },
  "coordinates": {
    "detector_stack_direction": [0.0, 0.0, 1.0],
    "camera_boresight_source_direction": [0.0, 0.0, -1.0]
  },
  "channel_mapping": {
    "chamber_to_channel": {"0": "ch2", "1": "ch1", "2": "ch0"},
    "channel_to_layer": {"ch2": 0, "ch1": 1, "ch0": 2}
  },
  "energy_grid": {
    "minimum_mev": 0.1,
    "maximum_mev": 3.0,
    "bin_width_mev": 0.1
  },
  "sky_grid": {"type": "healpix", "nside": 8, "nested": false},
  "trigger": {
    "required_channels": ["ch1", "ch2"],
    "minimum_hit_energy_mev": {"ch0": 0.0, "ch1": 0.0, "ch2": 0.0},
    "coincidence_window_ns": null
  },
  "runtime": {"numerical_threads_per_worker": 1},
  "batch": {
    "maximum_workers": 5,
    "memory_guard": {
      "enabled": true,
      "minimum_available_gib": 5.0,
      "estimated_worker_peak_gib": 4.0,
      "poll_interval_seconds": 2.0,
      "maximum_retries": 2
    }
  },
  "input": {
    "type": "geant4_legacy_root",
    "dataset_id": "replace_with_dataset_id",
    "root_path": "../../data/input/geant4/legacy/replace_with_input.root",
    "tree_name": "Tree1",
    "uproot_step_size": "100 MB",
    "minimum_positive_step_energy_mev": 0.0,
    "digitizer": {"mode": "truth"},
    "branches": {
      "event_id": "eventID",
      "chamber_id": "chamberID",
      "pixel_id": "pixelID",
      "energy_mev": "eDep_MeV",
      "x_mm": "x_post",
      "y_mm": "y_post",
      "z_mm": "z_post",
      "step_id": "stepID",
      "time_ns": "time_ns"
    }
  }
}

