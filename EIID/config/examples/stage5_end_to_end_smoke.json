{
  "schema_version": "0.1.0",
  "profile_purpose": "stage5_experiment_input_to_figures_prototype_not_physical",
  "paths": {
    "project_root": "../..",
    "input_root": "../../data/input",
    "response_root": "../../response_campaign/response_library",
    "output_root": "../../runs",
    "log_root": "../../logs"
  },
  "coordinates": {
    "detector_stack_direction": [0.0, 0.0, 1.0],
    "camera_boresight_source_direction": [0.0, 0.0, -1.0]
  },
  "channel_mapping": {
    "chamber_to_channel": {"0": "ch2", "1": "ch1", "2": "ch0"},
    "channel_to_layer": {"ch2": 0, "ch1": 1, "ch0": 2}
  },
  "energy_grid": {
    "minimum_mev": 0.1,
    "maximum_mev": 3.0,
    "bin_width_mev": 0.1
  },
  "sky_grid": {"type": "healpix", "nside": 4, "nested": false},
  "trigger": {
    "required_channels": ["ch1", "ch2"],
    "minimum_hit_energy_mev": {"ch0": 0.0, "ch1": 0.0, "ch2": 0.0},
    "coincidence_window_ns": 5.0
  },
  "runtime": {"numerical_threads_per_worker": 1},
  "batch": {
    "maximum_workers": 2,
    "memory_guard": {
      "enabled": true,
      "minimum_available_gib": 1.0,
      "estimated_worker_peak_gib": 0.5,
      "poll_interval_seconds": 2.0,
      "maximum_retries": 1
    }
  },
  "input": {
    "type": "experiment_delimited",
    "dataset_id": "stage5_smoke",
    "paths": {
      "ch0": "../../tests/fixtures/experiment/ch0.tsv",
      "ch1": "../../tests/fixtures/experiment/ch1.tsv",
      "ch2": "../../tests/fixtures/experiment/ch2.tsv"
    },
    "delimiter": "\t",
    "energy_mode": "direct_mev",
    "columns": {
      "event_id": "EventID",
      "pixel_id": "PixelID",
      "energy_mev": "Energy_MeV",
      "adc": null,
      "x_mm": "X_mm",
      "y_mm": "Y_mm",
      "z_mm": "Z_mm",
      "time_ns": "Time_ns"
    }
  },
  "event_response": {
    "model_id": "analytic_compton_gaussian_arm_v1",
    "parameters": {
      "arm_sigma_deg": 8.0,
      "minimum_relative_weight": 1e-6,
      "allow_nonphysical_response_for_smoke": true
    }
  },
  "background": {"mode": "none", "event_density": 0.0, "expected_count": 0.0},
  "reconstruction": {
    "sensitivity_kind": "conditional_acceptance_probability",
    "maximum_iterations": 40,
    "minimum_iterations": 5,
    "denominator_floor": 1e-12,
    "sensitivity_floor": 1e-12,
    "likelihood_relative_tolerance": 1e-9,
    "image_relative_tolerance": 1e-7,
    "convergence_patience": 3,
    "snapshot_first_iterations": 3,
    "snapshot_interval": 10
  },
  "visualization": {
    "enabled": true,
    "display_up_direction": [0.0, 1.0, 0.0],
    "smoothing_sigma_deg": 10.0,
    "smoothing_chunk_size": 128,
    "maximum_numpy_smoothing_pixels": 3072,
    "raster_width": 360,
    "raster_height": 180,
    "dpi": 120,
    "energy_bands_mev": [[0.1, 0.8], [0.8, 1.5], [1.5, 2.2], [2.2, 3.0]],
    "file_names": {
      "full_sky_raw": "full_sky_raw_camera_centered.png",
      "front_raw": "camera_front_raw.png",
      "front_smoothed": "camera_front_smoothed.png",
      "energy_spectrum": "reconstructed_energy_spectrum.png",
      "joint_distribution": "joint_direction_energy.png",
      "convergence": "convergence_metrics.png",
      "dashboard": "reconstruction_dashboard.png"
      ,"front_centered": "camera_front_centered_display.png"
      ,"planar_projection": "camera_centered_planar_projection.png"
      ,"source_zoom": "camera_front_source_zoom.png"
      ,"energy_band_skymaps": "energy_band_skymaps.png"
      ,"iteration_snapshots": "iteration_snapshots.png"
      ,"event_diagnostics": "event_response_diagnostics.png"
    }
  },
  "output": {
    "file_names": {
      "final_joint_image": "final_joint_image.npz",
      "event_summary": "event_summary.csv",
      "reconstruction_summary": "reconstruction_summary.json",
      "dataset_metadata": "dataset_metadata.json"
    }
  }
}
