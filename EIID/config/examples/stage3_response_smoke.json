{
  "schema_version": "0.1.0",
  "profile_purpose": "stage3_synthetic_response_roundtrip_not_formal_physics",
  "paths": {
    "project_root": "../..",
    "input_root": "../../data/input",
    "response_root": "../../response_campaign/response_library",
    "output_root": "../../runs",
    "log_root": "../../logs"
  },
  "coordinates": {
    "detector_stack_direction": [0.0, 0.0, 1.0],
    "camera_boresight_source_direction": [0.0, 0.0, -1.0]
  },
  "channel_mapping": {
    "chamber_to_channel": {"0": "ch2", "1": "ch1", "2": "ch0"},
    "channel_to_layer": {"ch2": 0, "ch1": 1, "ch0": 2}
  },
  "energy_grid": {
    "minimum_mev": 0.1,
    "maximum_mev": 3.0,
    "bin_width_mev": 0.1
  },
  "sky_grid": {"type": "healpix", "nside": 1, "nested": false},
  "trigger": {
    "required_channels": ["ch1", "ch2"],
    "minimum_hit_energy_mev": {"ch0": 0.0, "ch1": 0.0, "ch2": 0.0},
    "coincidence_window_ns": 5.0
  },
  "runtime": {"numerical_threads_per_worker": 1},
  "batch": {
    "maximum_workers": 2,
    "memory_guard": {
      "enabled": true,
      "minimum_available_gib": 1.0,
      "estimated_worker_peak_gib": 0.5,
      "poll_interval_seconds": 2.0,
      "maximum_retries": 1
    }
  },
  "input": {
    "type": "experiment_delimited",
    "dataset_id": "stage3_smoke",
    "paths": {
      "ch0": "../../tests/fixtures/experiment/ch0.tsv",
      "ch1": "../../tests/fixtures/experiment/ch1.tsv",
      "ch2": "../../tests/fixtures/experiment/ch2.tsv"
    },
    "delimiter": "\t",
    "energy_mode": "direct_mev",
    "columns": {
      "event_id": "EventID",
      "pixel_id": "PixelID",
      "energy_mev": "Energy_MeV",
      "adc": null,
      "x_mm": "X_mm",
      "y_mm": "Y_mm",
      "z_mm": "Z_mm",
      "time_ns": "Time_ns"
    }
  },
  "response": {
    "adapter": "prototype_npz_json",
    "library_path": "../../response_campaign/response_library/stage3_synthetic_smoke",
    "library_status": "prototype_not_formal",
    "overwrite_existing": false,
    "parameters": {
      "accepted_count_per_node": 80,
      "generated_count_per_node": 1000,
      "acceptance_definition": "digitized valid ch1 AND ch2 within configured coincidence window; no additional quality cut in this synthetic smoke",
      "generation_area_cm2": 120.0,
      "restricted_solid_angle_sr": 0.2,
      "source_distance_mm": 2000.0,
      "arm_sigma_deg": 8.0,
      "minimum_relative_weight": 1e-6,
      "geometry_version": "synthetic_not_geant4",
      "physics_list": "synthetic_not_geant4",
      "digitizer_version": "experimental_direct_mev_fixture"
    }
  }
}
