{
  "schema_version": "0.1.0",
  "profile_purpose": "stage4_sparse_lmmlem_run_lifecycle_smoke_not_physical_response",
  "paths": {
    "project_root": "../..",
    "input_root": "../../data/input",
    "response_root": "../../response_campaign/response_library",
    "output_root": "../../runs",
    "log_root": "../../logs"
  },
  "coordinates": {
    "detector_stack_direction": [0.0, 0.0, 1.0],
    "camera_boresight_source_direction": [0.0, 0.0, -1.0]
  },
  "channel_mapping": {
    "chamber_to_channel": {"0": "ch2", "1": "ch1", "2": "ch0"},
    "channel_to_layer": {"ch2": 0, "ch1": 1, "ch0": 2}
  },
  "energy_grid": {
    "minimum_mev": 0.1,
    "maximum_mev": 3.0,
    "bin_width_mev": 0.1
  },
  "sky_grid": {"type": "healpix", "nside": 1, "nested": false},
  "trigger": {
    "required_channels": ["ch1", "ch2"],
    "minimum_hit_energy_mev": {"ch0": 0.0, "ch1": 0.0, "ch2": 0.0},
    "coincidence_window_ns": 5.0
  },
  "runtime": {"numerical_threads_per_worker": 1},
  "batch": {
    "maximum_workers": 2,
    "memory_guard": {
      "enabled": true,
      "minimum_available_gib": 1.0,
      "estimated_worker_peak_gib": 0.5,
      "poll_interval_seconds": 2.0,
      "maximum_retries": 1
    }
  },
  "reconstruction": {
    "sensitivity_kind": "conditional_acceptance_probability",
    "maximum_iterations": 100,
    "minimum_iterations": 5,
    "denominator_floor": 1e-12,
    "sensitivity_floor": 1e-12,
    "likelihood_relative_tolerance": 1e-10,
    "image_relative_tolerance": 1e-8,
    "convergence_patience": 3,
    "snapshot_first_iterations": 3,
    "snapshot_interval": 10
  }
}
